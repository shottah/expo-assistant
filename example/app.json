{
  "expo": {
    "name": "expo-assistant-example",
    "slug": "expo-assistant-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "expo.modules.assistant.example"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "expo.modules.assistant.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-assistant",
        {
          "intents": ["search"],
          "ios": {
            "siriUsageDescription": "Search the example app via voice",
            "appShortcuts": [
              {
                "id": "search",
                "title": "Search Example",
                "phrases": ["Search in example", "Search example"],
                "systemImageName": "magnifyingglass"
              }
            ]
          }
        }
      ]
    ]
  }
}