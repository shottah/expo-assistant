{
  "name": "expo-assistant",
  "version": "0.1.0",
  "description": "Native voice assistant integration for Expo apps with Siri and Google Assistant support",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "app.plugin": "./plugin/build/index.js",
  "scripts": {
    "build:plugin": "tsc --project plugin/tsconfig.json",
    "build": "expo-module build && npm run build:plugin",
    "clean": "expo-module clean && rm -rf plugin/build",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "test:jest": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-assistant",
    "ExpoAssistant",
    "siri",
    "google-assistant",
    "voice",
    "voice-commands",
    "sirikit",
    "app-intents",
    "app-actions",
    "voice-assistant"
  ],
  "repository": "https://github.com/shottah/expo-assistant",
  "bugs": {
    "url": "https://github.com/shottah/expo-assistant/issues"
  },
  "author": "shottah <14793093+shottah@users.noreply.github.com> (https://github.com/shottah)",
  "license": "MIT",
  "homepage": "https://github.com/shottah/expo-assistant#readme",
  "devDependencies": {
    "@expo/config-plugins": "^9.0.0",
    "@expo/config-types": "^52.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.0",
    "@types/plist": "^3.0.5",
    "@types/react": "~19.1.0",
    "expo": "^54.0.7",
    "expo-module-scripts": "^5.0.7",
    "jest": "^29.7.0",
    "plist": "^3.1.0",
    "react-native": "0.81.4",
    "ts-jest": "^29.4.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@expo/config-plugins": "^9.0.0"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
